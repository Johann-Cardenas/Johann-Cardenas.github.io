{
  "name": "stride-lab",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Stride Lab — client-side running-form and gait analysis. Pose estimation, gait-event detection and biomechanical metrics, computed entirely in the browser.",
  "scripts": {
    "test": "node test/run.mjs",
    "banner": "node tools/make-banner.mjs",
    "benchmark:model": "node tools/benchmark-model.mjs",
    "test:browser": "playwright test",
    "test:smoke": "playwright test --grep \"synthetic runner|playback decoder|inference worker\"",
    "test:release": "npm test && npm run test:browser"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
